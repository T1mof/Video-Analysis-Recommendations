{
  "name": "video-recommendation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/workers/index.ts",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/workers/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check:env": "tsx scripts/check-env.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed-users.ts",
    "ingest": "tsx scripts/ingest.ts",
    "preprocess": "tsx scripts/preprocess.ts",
    "analyze": "tsx scripts/analyze.ts",
    "simulate": "tsx scripts/simulate-events.ts",
    "demo:profile": "tsx scripts/simulate-events.ts",
    "rebuild-feeds": "tsx scripts/rebuild-feeds.ts",
    "cost-model": "tsx scripts/cost-model.ts",
    "bench-vlm": "tsx scripts/bench-vlm.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@aws-sdk/s3-request-presigner": "^3.1126.0",
    "@fastify/static": "^10.1.3",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
