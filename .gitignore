node_modules/
dist/
coverage/
*.log
npm-debug.log*

.env
.env.local
.env.*.local

# Local media + scratch. Source videos are never committed (size + 18+ content).
# The manifest and README are metadata about the corpus, not the corpus, so they
# stay tracked; mapping.json holds per-database UUIDs and is regenerated.
data/seed/*
!data/seed/README.md
!data/seed/manifest.json
data/tmp/
data/frames/
storage/

# Gold labels reference local video ids and describe 18+ content; the process for
# regenerating them is documented in data/gold/README.md, which IS tracked.
data/gold/labels.json

# Playwright browser session state (contains auth cookies)
.auth/
playwright-report/
test-results/

.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
