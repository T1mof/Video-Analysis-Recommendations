# Copy to .env and adjust. Every knob that affects analysis cost or ranking
# behaviour is here on purpose - see ARCHITECTURE.md "Cost estimation".

# ---------------------------------------------------------------- runtime
NODE_ENV=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=3000

# ---------------------------------------------------------------- datastores
DATABASE_URL=postgres://app:app@localhost:5432/videorec
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=videos
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# How long a presigned media URL stays valid. In production this is a CDN URL.
MEDIA_URL_TTL_SECONDS=3600

# ---------------------------------------------------------------- ingestion
INGEST_MAX_DURATION_SECONDS=300
INGEST_MIN_DURATION_SECONDS=1
INGEST_TMP_DIR=data/tmp
# Note: aspect ratio is not an ingestion filter. Landscape videos are ingested and
# flagged with a not_vertical warning; whether the feed shows them is decided later.
# Local corpus the demo runs on. Videos here are never committed (see .gitignore).
DEMO_SOURCE_DIR=data/seed/videos
# Optional creator attribution: [{ "file": "video_01.mp4", "creatorId": "...",
# "creatorHandle": "..." }]. Absent is normal - creator fields are nullable.
DEMO_MANIFEST_PATH=data/seed/manifest.json
POSTER_POSITION_PCT=0.15
POSTER_WIDTH=360

# ---------------------------------------------------------------- vision provider
# mock             - deterministic fake features; no GPU needed (tests + offline demo)
# openai-compatible - any /v1/chat/completions server: Ollama, llama.cpp, vLLM, LM Studio
VISION_PROVIDER=mock
VISION_BASE_URL=http://localhost:11434/v1
VISION_API_KEY=not-needed
VISION_MODEL=qwen2.5vl-3b-16k
VISION_MODEL_VERSION=ollama-q4-16k
VISION_TIMEOUT_MS=180000
VISION_MAX_RETRIES=1

# ---------------------------------------------------------------- frame sampling
# Frame budget by video duration. This is THE cost lever: a VLM bills for
# frames x pixels-per-frame, so these bounds set the per-video price.
#   <= 30s -> 6,  <= 60s -> 8,  <= 120s -> 12,  longer -> 16
FRAMES_TIER_SHORT=6
FRAMES_TIER_MEDIUM=8
FRAMES_TIER_LONG=12
FRAMES_TIER_MAX=16
FRAMES_BOUND_SHORT=30
FRAMES_BOUND_MEDIUM=60
FRAMES_BOUND_LONG=120
# Hard ceiling: no video may ever cost more frames than this.
MAX_ANALYSIS_FRAMES=16
# Floor after de-duplication, when enough distinct frames exist to reach it.
MIN_ANALYSIS_FRAMES=3
# Longest edge sent to the model. Smaller sources are never upscaled.
FRAME_MAX_LONG_EDGE=768
FRAME_JPEG_QUALITY=4
# Perceptual-hash distance below which two frames count as duplicates (0..64).
DEDUP_HAMMING_THRESHOLD=6
# Skip intros/outros: fraction of the video trimmed from each end.
HEAD_TAIL_TRIM_PCT=0.05
# Scene-aware sampling is OFF by default: detecting cuts means decoding every
# frame, which is the cost adaptive sampling exists to avoid. Enable only when the
# extra decode pass is worth it.
SAMPLING_SCENE_AWARE=false
SCENE_THRESHOLD=0.3
SCENE_SNAP_WINDOW_SECONDS=1.5
# Debug artefacts only (contact sheets, --keep-frames). Not part of the pipeline.
PREPROCESS_DEBUG_DIR=data/debug

# ---------------------------------------------------------------- candidate generation
CAND_SIMILAR_K=200
CAND_TAG_K=100
CAND_TRENDING_K=100
CAND_FRESH_K=50
CAND_EXPLORE_K=50
TRENDING_WINDOW_HOURS=72

# ---------------------------------------------------------------- ranking weights
RANK_W_AFFINITY=1.0
RANK_W_QUALITY=0.15
RANK_W_FRESHNESS=0.20
RANK_W_POPULARITY=0.25
RANK_W_FATIGUE=0.35
RANK_W_EXPLORATION=0.10
RANK_W_CREATOR_AFFINITY=0.20
# Diversity re-rank: 0 = pure score, 1 = pure novelty.
DIVERSITY_LAMBDA=0.30
# Two independent rules. The creator cap applies only to videos that have a
# creator_id; sources that do not expose one leave it null and are exempt.
DIVERSITY_MAX_SAME_TAG_IN_TOP10=3
DIVERSITY_MAX_SAME_CREATOR=2

# ---------------------------------------------------------------- user profile
PROFILE_HALFLIFE_DAYS=7
# Below this many interactions the feed leans on trending/fresh instead of the profile.
COLD_START_MIN_INTERACTIONS=5

# ---------------------------------------------------------------- feed serving
FEED_SIZE=50
FEED_TTL_SECONDS=3600
# Enqueue a refill once fewer than this many items remain in the cached feed.
FEED_REFILL_WATERMARK=10
# Precomputed global trending feed, refreshed on a timer by a background worker.
# A personalised-feed cache miss is served from this, so an HTTP request never
# reaches pgvector or the ranker - the hot path is Redis-only, unconditionally.
TRENDING_FEED_SIZE=100
TRENDING_FEED_REFRESH_SECONDS=300

# ---------------------------------------------------------------- workers
ANALYSIS_CONCURRENCY=1
EVENT_CONCURRENCY=4
FEED_CONCURRENCY=2

# ---------------------------------------------------------------- cost model inputs
# Actual rate paid for the benchmark GPU (RTX 4090), in its billing currency.
COST_GPU_HOURLY_RUB=41.06
# USD conversion is OFF unless a real, dated rate is supplied. Leave at 0 rather
# than inventing a rate - a made-up exchange rate turns a measured cost into a guess.
COST_RUB_PER_USD=0
COST_RUB_RATE_SOURCE=
COST_GPU_HOURLY_USD=0.60
COST_HOSTED_INPUT_USD_PER_MTOK=0.20
COST_HOSTED_OUTPUT_USD_PER_MTOK=0.60
COST_STORAGE_USD_PER_GB_MONTH=0.023
COST_AVG_VIDEO_MB=8
